// Compiled only into the disposable signed Ubuntu TCG guest fixture.
package hypervisor

import (
	"aster/billing/controllerapi"
	"context"
	"encoding/xml"
	"os"
	"os/exec"
	"path/filepath"
	"runtime"
	"strings"
	"testing"
	"time"
)

func TestNativeBandwidthLiveXML(t *testing.T) {
	stage := "setup"
	t.Cleanup(func() {
		if t.Failed() {
			t.Log("native bandwidth_failure_stage=" + stage)
		}
	})
	if runtime.GOOS != "linux" || os.Geteuid() != 0 {
		t.Fatal("native Linux root fixture required")
	}
	if _, err := os.Stat("/dev/kvm"); !os.IsNotExist(err) {
		t.Fatal("fixture must use TCG")
	}
	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
	defer cancel()
	command := func(binary string, args ...string) []byte {
		t.Helper()
		raw, err := exec.CommandContext(ctx, binary, args...).CombinedOutput()
		if err != nil {
			t.Fatalf("fixed native %s failed: %v: %s", filepath.Base(binary), err, raw)
		}
		return raw
	}
	virsh := func(args ...string) []byte {
		return command(Virsh, append([]string{"--connect", "qemu:///system"}, args...)...)
	}
	id := strings.Repeat("e", 32)
	domain := "aster-" + id
	dir := "/var/lib/libvirt/images/aster-bandwidth-fixture"
	if err := os.Mkdir(dir, 0755); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { os.RemoveAll(dir) })
	if err := os.Chmod(dir, 0755); err != nil {
		t.Fatal(err)
	}
	stage = "bridge-create"
	command("/usr/sbin/ip", "link", "add", "asterqos0", "type", "bridge")
	t.Cleanup(func() { exec.Command("/usr/sbin/ip", "link", "delete", "asterqos0").Run() })
	stage = "bridge-up"
	command("/usr/sbin/ip", "link", "set", "asterqos0", "up")
	approved, err := LoadConfig("/etc/aster-node/node.json")
	if err != nil {
		t.Fatal(err)
	}
	m := Manager{Config: Config{NodeID: approved.NodeID, Images: approved.Images, Network: Network{Bridge: "asterqos0", Filter: "aster-native-qos"}}}
	i := Instance{ID: id, OwnerRef: strings.Repeat("f", 32), Domain: domain, Disk: filepath.Join(dir, "system.qcow2"), IPv4: "192.0.2.2", MAC: "52:54:00:12:34:56", Resources: controllerapi.Resources{ImageID: "signed-ubuntu", CPUCores: 1, MemoryMiB: 128, InboundBandwidthMbps: 100, BandwidthMbps: 8}}
	// Production validates the disk header and approved image binding while
	// generating XML. A flat bandwidth fixture must exist before that check.
	stage = "disk-create"
	command(QemuImg, "create", "-f", "qcow2", i.Disk, "16M")
	if err := os.Chmod(i.Disk, 0600); err != nil {
		t.Fatal(err)
	}
	stage = "domain-xml"
	raw, err := m.domainXML(i)
	if err != nil {
		t.Fatal(err)
	}
	// Only the hypervisor backend changes for this test. The interface XML is
	// byte-for-byte generated by the same function used by create and resize.
	raw = []byte(strings.Replace(string(raw), `type="kvm"`, `type="qemu"`, 1))
	filter := filepath.Join(dir, "filter.xml")
	if err = os.WriteFile(filter, ApprovedFilterXML("aster-native-qos"), 0600); err != nil {
		t.Fatal(err)
	}
	stage = "filter-define"
	virsh("nwfilter-define", filter)
	t.Cleanup(func() {
		exec.Command(Virsh, "--connect", "qemu:///system", "nwfilter-undefine", "aster-native-qos").Run()
	})
	path := filepath.Join(dir, "domain.xml")
	if err = os.WriteFile(path, raw, 0600); err != nil {
		t.Fatal(err)
	}
	stage = "domain-define"
	virsh("define", path)
	t.Cleanup(func() {
		exec.Command(Virsh, "--connect", "qemu:///system", "destroy", domain).Run()
		exec.Command(Virsh, "--connect", "qemu:///system", "undefine", domain).Run()
	})
	stage = "domain-start"
	virsh("start", domain)
	stage = "domain-read"
	var live domainXML
	if err = xml.Unmarshal(virsh("dumpxml", domain), &live); err != nil {
		t.Fatal(err)
	}
	stage = "bandwidth"
	if len(live.Devices.Interfaces) != 1 || !bandwidthMatches(live.Devices.Interfaces[0].Bandwidth, bandwidthFor(i.Resources)) {
		t.Fatal("live domain lost production inbound/outbound bandwidth")
	}
	stage = "power-state"
	if strings.TrimSpace(string(virsh("domstate", domain))) != "running" {
		t.Fatal("native domain not running")
	}
}
